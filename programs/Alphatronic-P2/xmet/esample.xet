; SAMPLE PROGRAM #1
; FROM ETA-3400 SOFTWARE REFERENCE MANUAL

	ORG	100H

REDIS	EQU	0FCBCH
DIGADD	EQU	0F0H
OUTCH	EQU	0FE3AH
MAIN	EQU	1400H

START	JSR	REDIS		;SET UP FIRST DISPLAY ADDRESS
	LDA A	#1		;FIRST SEGMENT CODE
	BRA	OUTX
SAME	LDA B	DIGADD+1,D	;FIX DISPLAY ADDRESS
	ADD B	#10H		;FOR NEXT SEGMENT
	STA B	DIGADD+1,D
	ASL A			;NEXT SEGMENT CODE
OUTX	JSR	OUTCH		;OUTPUT SEGMENT
	LDX	#2F00H		;TIME TO WAIT
WAIT	DEX
	BNE	WAIT		;TIME OUT YET?
	TAB
	TST B			;LAST SEGMENT THIS DISPLAY?
	BNE	SAME		;NEXT SEGMENT
	LDA A	#1		;RESET SEGMENT CODE
	LDX	DIGADD,D	;NEXT DISPLAY
	CPX	#0C10FH		;LAST DISPLAY YET
	BNE	OUTX
	JSR	MAIN		;RETURN TO FANTOM II
	END	START
