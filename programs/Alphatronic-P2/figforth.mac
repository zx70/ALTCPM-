        MOV  H,B
        POP  D
        POP  B
        XTHL
        XCHG
FILL1:  MOV   A,B  ; BEGIN
        ORA   C
        JZ    FILL2 ; WHILE
        MOV   A,L
        STAX  D
        INX   D
        DCX   B
        JMP   FILL1  ; REPEAT
FILL2:  POP   B
        JMP   NEXT
