HBSW:	DW  DOVAR
	DW  0
;
;	CRGR = CREATE GROSSSCHREIBUNG
;	       WANDELT DEN NAMEN IN NUR GROSSBUCHSTABEN UM
	DB  84H
	DB  'CRG'
	DB  'R'+80H
	DW  HBSW-7
CRGR:   DW  $+2
	POP	H	; Hole adresse des Wortes vom Stack
	PUSH	B	; RETTE FORTH-PC
	MOV	A,M	; HOLE LENGTH BIT
	INR	A
	MOV	B,A	; SPEICHERE ALS ZAEHLER
CRGR2:	DCR	B
	JZ	CRGR3	; AUFHOEHREN WENN WORT ZU ENDE
	INX	H	; WORT BYTE
	MOV	A,M	; HOLE BYTE VOM WORT
	ANI	7FH	; HOECHSTES BIT NICHT ERLAUBT
	CPI	60H	; IST ES KLEINBUCHSTABE ?
	JC	CRGR1	; NEIN ALSO SO LASSEN
	ANI	11011111B ; WANDLE IN GROSSBUCHSTABEN
CRGR1:	MOV	M,A	; ZURUECKSPEICHERN DES NEUEN WERTES
	JMP	CRGR2	; WEITERWANDELN
CRGR3:	POP	B
	JMP	NEXT	; GANZES WORD GEWANDELT. ENDE
