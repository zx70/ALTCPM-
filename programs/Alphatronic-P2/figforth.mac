        DB    '>'+80H
        DW    BUILD-0AH
DOES:   DW    DOCOL
        DW    FROMR
        DW    LATES
        DW    PFA
        DW    STORE
        DW    PSCOD
DODOE:  LHLD  RPP   ; (HL) <-  (RP)
        DCX   H
        MOV   M,B   ; (R1) <- (IP) = PFA = (SUBSTIT. CFA)
        DCX   H
        MOV   M,C
        SHLD  RPP   ; (RP) <- (RP) -2
        INX   D     ; (DE) <- PFA = (SUSTITU. CFA)
        XCHG
        MOV   C,M
        INX   H
        MOV   B,M

        INX   H
        JMP   HPUSH   ; (S1) <- PFA+2 = SUBSTITU.PFA
;  
        DB    85H    ; COUNT
        DB    'COUN'
        DB    'T'+80H
        DW    DOES-8
COUNT:  DW    DOCOL
